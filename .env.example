# Environment variables for deepseek-balance (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

DEEPSEEK_API_KEY=
# How often to poll the balance API. The "daily heartbeat" widget needs fine
# granularity to spot rapid single-interval drops, so 1m is the default.
POLL_INTERVAL=1m
DB_PATH=/data/deepseek.db
# Daily heartbeat tuning (optional; see README).
RAPID_WINDOW_MINUTES=60
RAPID_MIN_PCT=0.02
RAPID_MULT=2.0
MAX_GAP_MINUTES=30
NORMAL_DAYS=14
# Spend-interval summary: interval width and how far back to look.
SPEND_SLICE_MINUTES=5
SPEND_SUMMARY_HOURS=24
