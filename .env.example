# Environment variables for deepseek-balance (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

DEEPSEEK_API_KEY=
# How often to poll the balance API. The "daily heartbeat" widget needs fine
# granularity to spot rapid single-interval drops, so 1m is the default.
POLL_INTERVAL=1m
DB_PATH=/data/deepseek.db
# Daily heartbeat tuning (optional; see README).
RAPID_WINDOW_MINUTES=60
RAPID_MIN_PCT=0.02
RAPID_MULT=2.0
MAX_GAP_MINUTES=30
NORMAL_DAYS=14
# Spend-interval summary: interval width, how far back to look, and the
# outlier rule that flags a single interval as unusually high (a "spike").
SPEND_SLICE_MINUTES=5
SPEND_SUMMARY_HOURS=24
SPIKE_MULT=3.0
SPIKE_MIN_RATIO=2.0
MIN_INTERVALS_FOR_BASELINE=10
NORMAL_BAND=2.0
# "Why was it high?" analysis against Arize Phoenix. When PHOENIX_BASE_URL is
# set, the app joins the phoenix/ai_proxy network (http://phoenix:6006 in prod)
# and periodically explains unusually-high spend intervals from LLM spans.
PHOENIX_BASE_URL=http://phoenix:6006
PHOENIX_PROJECT=default
# Detection: how many complete days back to look for high intervals.
ANALYSIS_LOOKBACK_DAYS=3
# How wide to widen each interval when querying Phoenix (traces bound on start).
PHOENIX_WINDOW_PAD_SECONDS=60
# Analysis scheduler cadence + cap on Phoenix dives per pass (bounds query volume).
ANALYSIS_INTERVAL=10m
MAX_DIAGNOSE_PER_RUN=25
